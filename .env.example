# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/aura-farmer"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Tavily (job search)
TAVILY_API_KEY=""

# AWS Textract & Resume S3 Storage (provisioned via ./terraform)
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BEDROCK_MODEL_ID="amazon.nova-micro-v1:0"
AWS_TEXTRACT_SNS_TOPIC_ARN=""
AWS_TEXTRACT_ROLE_ARN=""
AWS_TEXTRACT_SQS_QUEUE_URL=""

# --- Apply workflow (see docs/LOCAL_SETUP.md). Placeholders only. ---
# REPO_DRIVER="postgres"          # memory (dev default) | postgres (prod default)
# STORAGE_DRIVER="s3"             # memory | file (dev) | s3
# ALLOW_DEV_S3="1"                # required to use s3 outside production (shared bucket)
# BUCKET_S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
# BUCKET_REGION="<project-region>"
# BUCKET_NAME="<bucket-name>"
# BUCKET_ACCESS_KEY=""            # server-only secret
# BUCKET_SECRET_KEY=""            # server-only secret
# LLM_PROVIDER=""                 # unset = rules only | mock (dev) | anthropic
# LLM_ALLOW_PAID_CALLS=""         # must be 1 for anthropic
# APPLY_LLM_API_KEY=""            # server-only secret
# JEV_PROVIDER=""                 # unset | typesafe
# JEV_ALLOW_PAID_CALLS=""
# APPLY_JEV_API_KEY=""            # server-only secret
