project_name = "aura-farmer"
environment  = "dev"
aws_region   = "ap-southeast-2"

# AWS Credentials for Terraform (optional here if exported as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in your shell)
# Note: terraform.tfvars is gitignored so your keys will not be committed.
# aws_access_key_id     = "AKIA..."
# aws_secret_access_key = "your-secret-access-key"
# aws_session_token     = null # Only needed for temporary STS/SSO credentials

# Create a dedicated least-privilege IAM user + access key for the Next.js app
create_app_iam_user   = true
create_app_access_key = true

tags = {
  Owner = "aura-farmer"
}
